New-Item .\dist -ItemType Directory | Out-Null
pycrucible -e . -o .\dist\HR_Attendance_Dashboard.exe

Write-Host ''
Write-Host 'Build selesai:' -ForegroundColor Green
Write-Host '.\dist\HR_Attendance_Dashboard.exe'
